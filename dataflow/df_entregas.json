{
	"name": "df_entregas",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "entregas_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "entregas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          entrega_id as string,",
				"          pedido_id as string,",
				"          repartidor_id as string,",
				"          hora_salida as string,",
				"          hora_entrega as string,",
				"          tiempo_entrega_min as string,",
				"          distancia_km as string,",
				"          estado_entrega as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 split(!isNull(entrega_id) && !isNull(pedido_id) && !isNull(repartidor_id) && !isNull(hora_salida) && isTimestamp(hora_salida) && (isNull(hora_entrega) || isTimestamp(hora_entrega))&& ((isInteger(tiempo_entrega_min) && toInteger(tiempo_entrega_min) > 0)|| isNull(tiempo_entrega_min)) && isDecimal(distancia_km) && !isNull(estado_entrega),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos derive(tiempo_entrega_min = toInteger(tiempo_entrega_min),",
				"          distancia_km = toDecimal(distancia_km)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          entrega_id as string,",
				"          pedido_id as string,",
				"          repartidor_id as string,",
				"          hora_salida as string,",
				"          hora_entrega as string,",
				"          tiempo_entrega_min as integer,",
				"          distancia_km as decimal(10,2),",
				"          estado_entrega as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          entrega_id,",
				"          pedido_id,",
				"          repartidor_id,",
				"          hora_salida,",
				"          hora_entrega,",
				"          tiempo_entrega_min,",
				"          distancia_km,",
				"          estado_entrega",
				"     )) ~> sink1"
			]
		}
	}
}