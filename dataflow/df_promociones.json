{
	"name": "df_promociones",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "promociones_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "promociones_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          promocion_id as string,",
				"          nombre_promocion as string,",
				"          fecha_inicio as string,",
				"          fecha_fin as string,",
				"          porcentaje_descuento as string,",
				"          canal_aplicable as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 split(!isNull(canal_aplicable) && toInteger(porcentaje_descuento) >=0 && toInteger(porcentaje_descuento) <=100 && fecha_inicio < fecha_fin,",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos derive(fecha_inicio = toDate(fecha_inicio),",
				"          fecha_fin = toDate(fecha_fin),",
				"          porcentaje_descuento = toDecimal(porcentaje_descuento)) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          promocion_id as string,",
				"          nombre_promocion as string,",
				"          fecha_inicio as date,",
				"          fecha_fin as date,",
				"          porcentaje_descuento as decimal(5,2),",
				"          canal_aplicable as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          promocion_id,",
				"          nombre_promocion,",
				"          fecha_inicio,",
				"          fecha_fin,",
				"          porcentaje_descuento,",
				"          canal_aplicable",
				"     )) ~> sink1"
			]
		}
	}
}